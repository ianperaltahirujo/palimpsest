# Copy to .env and fill in. Never commit the real .env (it's gitignored).

# Required only when [backend] name/fallback = "anthropic" in your
# palimpsest.toml. Resolved by the Anthropic SDK -- palimpsest never reads
# a key from a TOML file or CLI flag.
ANTHROPIC_API_KEY=

# Optional: a denylist file (one term per line) used by tools/scrub_check.py
# to catch confidential names/filenames before they're committed. Keep this
# file itself OUTSIDE the repo -- it is disclosive by nature.
PALIMPSEST_DENYLIST=
